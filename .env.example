# Copy to .env and fill in. Never commit .env.
QLOO_API_KEY=replace-with-your-event-credential
QLOO_BASE_URL=https://hackathon.api.qloo.com
GEMINI_API_KEY=replace-with-your-gemini-key
# Optional backup models when Gemini is down or out of quota (https://openrouter.ai, free models)
OPENROUTER_API_KEY=
# Optional: where to watch, by country (free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Shared by the web app and the backend so the backend can trust the visitor IP the web app forwards
PROXY_SECRET=replace-with-a-long-random-string

# Where the pipeline caches the subtitle index and raw files (outside the repo)
COMPRENDE_CACHE=~/.cache/comprende
